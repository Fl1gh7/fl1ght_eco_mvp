# YandexGPT
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Redis (Celery broker + scout dedup)
REDIS_URL=redis://127.0.0.1:6379/0

# CRM Basic Auth — set your own values, do not use defaults from source
CRM_ADMIN_USER=
CRM_ADMIN_PASS=

# Telegram bot (sales + order alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Same value as secret_token in setWebhook
TELEGRAM_WEBHOOK_SECRET=

# VK community callback
VK_GROUP_TOKEN=
VK_CONFIRMATION_CODE=
VK_CALLBACK_SECRET=
VK_USER_TOKEN=
VK_GROUP_ID=

# Telegram user session (Pyrogram scout)
TELETHON_API_ID=
TELETHON_API_HASH=

# Avito is a stub — not a live integration. Do not fill these until the channel is built.
# AVITO_CLIENT_ID=
# AVITO_CLIENT_SECRET=

# Optional: comma-separated scout keywords
SCOUT_KEYWORDS=ремонт,мастер,починить,экран,дисплей,айфон,iphone

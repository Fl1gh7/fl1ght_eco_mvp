# YandexGPT
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Redis: брокер Celery и дедуп скаута VK
REDIS_URL=redis://127.0.0.1:6379/0

# HTTP Basic для админки скаутов и карточек заказов
CRM_ADMIN_USER=
CRM_ADMIN_PASS=

# Официальный бот продаж и канал алертов о закрытых заказах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Тот же secret_token, что в setWebhook
TELEGRAM_WEBHOOK_SECRET=

# Callback сообщества VK
VK_GROUP_TOKEN=
VK_CONFIRMATION_CODE=
VK_CALLBACK_SECRET=
VK_USER_TOKEN=
VK_GROUP_ID=

# Юзер-сессия Pyrogram (скаут групп)
TELETHON_API_ID=
TELETHON_API_HASH=

# Avito не подключён. Поля пустые, пока не будет боевого канала.
# AVITO_CLIENT_ID=
# AVITO_CLIENT_SECRET=

# Ключи радара VK, через запятую
SCOUT_KEYWORDS=ремонт,мастер,починить,экран,дисплей,айфон,iphone
